{
  "name": "makepages",
  "version": "0.9.6",
  "description": "A very simple and flexible Static Site Generator powered by esbuild and nunjucks",
  "keywords": [
    "static-site-generator",
    "static-site",
    "ssg",
    "site-generator",
    "website-generator",
    "javascript",
    "esbuild",
    "nunjucks",
    "chokidar",
    "live-reload",
    "html-webpack-plugin",
    "jekyll",
    "gatsby",
    "hugo",
    "11ty"
  ],
  "license": "MIT",
  "bin": {
    "makepages": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf --glob dist/*",
    "build": "tsc -p tsconfig.json",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Athlon1600/makepages.git",
    "directory": "packages/cli"
  },
  "homepage": "https://makepages.dev",
  "devDependencies": {
    "@tsconfig/node20": "^20.1.9",
    "@types/node": "^20",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@11ty/nunjucks": "^4.0.0-alpha.1",
    "@types/html-minifier-terser": "^7.0.2",
    "chalk": "^4.1.2",
    "chokidar": "^4.0.3",
    "esbuild": "^0.28.1",
    "esbuild-plugin-vue-next": "^0.1.4",
    "glob": "^13.0.6",
    "html-minifier-terser": "^7.2.0",
    "jszip": "^3.10.1",
    "live-server": "^1.2.2",
    "rimraf": "^6.1.3",
    "vue": "^3.5.35"
  }
}
